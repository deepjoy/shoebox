[74.652466, "o", "  \u001b[38;2;197;185;155m# Phase 7 checklist items demonstrated:\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] POST /{bucket}?sync returns 200 immediately\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Sync submits L1 at HIGH and L2 at NORMAL priority\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Sync discovers new files added to filesystem\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Move detection preserves object_id across renames\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Sync detects deleted files\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] S3 API operations coexist with sync-discovered files\u001b[0m\r\n"]
[74.652759, "o", "  \u001b[38;2;197;185;155m# \u001b[0m\r\n  \u001b[38;2;197;185;155m# Items tested via unit tests (not in demo):\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Library API (Shoebox::sync()) works without HTTP\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Sync does not trigger L3 (content hashing)\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Priority override on ScanL1Task/ScanL2Task\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] upsert_object returns persisted object_id via RETURNING\u001b[0m\r\n"]
