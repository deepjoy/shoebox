[67.613954, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[30;1H\u001b[?1h\u001b=\r{\u001b[m\r\n    \"Contents\": [\u001b[m\r\n        {\u001b[m\r\n            \"Key\": \"hello.txt\",\u001b[m\r\n            \"LastModified\": \"2026-02-15T20:27:46.532640+00:00\",\u001b[m\r\n            \"ETag\": \"\\\"72ca40fa12a077734991a45892961459\\\"\",\u001b[m\r\n            \"Size\": 20,\u001b[m\r\n            \"StorageClass\": \"STANDARD\"\u001b[m\r\n        },\u001b[m\r\n        {\u001b[m\r\n            \"Key\": \"info.json\",\u001b[m\r\n            \"LastModified\": \"2026-02-15T20:27:52.045406+00:00\",\u001b[m\r\n            \"ETag\": \"\\\"69b32059aabf2097e651fb8ec3d61d53\\\"\",\u001b[m\r\n            \"Size\": 35,\u001b[m\r\n            \"StorageClass\": \"STANDARD\"\u001b[m\r\n        }\u001b[m\r\n    ],\u001b[m\r\n    \"RequestCharged\": null,\u001b[m\r\n    \"Prefix\": \"\",\u001b[m\r\n    \"NextToken\": \"eyJDb250aW51YXRpb25Ub2tlbiI6ICJpbmZvLmpzb24ifQ==\"\u001b[m\r\n}\u001b[m\r\n\u001b[7m(END)\u001b[27m\u001b[K"]
