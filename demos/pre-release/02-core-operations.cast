[132.21673, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Delete Operations\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[134.718644, "o", "  \u001b[38;2;197;185;155m# aws s3 rm deletes a single object via DeleteObject.\u001b[0m\r\n"]
[137.220731, "o", "\r\n\u001b[38;2;142;155;105m▸ Delete hello.txt\u001b[0m\r\n"]
[139.72267, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 rm s3://photos/hello.txt\u001b[0m\r\n"]
[140.137676, "o", "delete: s3://photos/hello.txt\r\n"]
[142.724821, "o", "\r\n\u001b[38;2;142;155;105m▸ Verify it's gone\u001b[0m\r\n"]
[145.227149, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 ls s3://photos/ --recursive\u001b[0m\r\n"]
[145.638554, "o", "2026-02-15 14:16:45         35 info.json\r\n"]
[145.638603, "o", "2026-02-15 14:16:51         38 vacation/beach.jpg\r\n"]
[145.638745, "o", "2026-02-15 14:16:51         41 vacation/poolside.jpg\r\n2026-02-15 14:16:51         39 vacation/sunset.jpg\r\n"]
[148.227491, "o", "\r\n\u001b[38;2;142;155;105m▸ Bulk-delete vacation/ with --recursive (uses DeleteObjects API)\u001b[0m\r\n"]
[150.729204, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 rm s3://photos/vacation/ --recursive\u001b[0m\r\n"]
[151.156812, "o", "delete: s3://photos/vacation/poolside.jpg\r\n"]
[151.167347, "o", "delete: s3://photos/vacation/beach.jpg\r\n"]
[151.183436, "o", "delete: s3://photos/vacation/sunset.jpg\r\n"]
[153.772536, "o", "\r\n\u001b[38;2;142;155;105m▸ List remaining objects (should be 1: info.json)\u001b[0m\r\n"]
[156.27418, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 ls s3://photos/ --recursive\u001b[0m\r\n"]
[156.668088, "o", "2026-02-15 14:16:45         35 info.json\r\n"]
[159.252953, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Done!\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[161.754634, "o", "\r\n  \u001b[38;2;142;155;105m✓ All Current S3 operations verified with the standard AWS CLI.\u001b[0m\r\n  \u001b[38;2;142;155;105m✓ shoebox is a drop-in local replacement for S3.\u001b[0m\r\n"]
