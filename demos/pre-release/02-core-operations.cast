[146.734522, "o", "\r\n\u001b[38;2;142;155;105m▸ Verify it's gone\u001b[0m\r\n"]
[149.236621, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 ls s3://photos/ --recursive\u001b[0m\r\n"]
[149.645805, "o", "2026-02-15 12:27:52         35 info.json\r\n"]
[149.645901, "o", "2026-02-15 12:27:57         38 vacation/beach.jpg\r\n2026-02-15 12:27:57         41 vacation/poolside.jpg\r\n"]
[149.645966, "o", "2026-02-15 12:27:57         39 vacation/sunset.jpg\r\n"]
[152.229526, "o", "\r\n\u001b[38;2;142;155;105m▸ Bulk-delete vacation/ with --recursive (uses DeleteObjects API)\u001b[0m\r\n"]
[154.731167, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 rm s3://photos/vacation/ --recursive\u001b[0m\r\n"]
[155.153638, "o", "delete: s3://photos/vacation/beach.jpg\r\n"]
[155.157095, "o", "delete: s3://photos/vacation/sunset.jpg\r\n"]
[155.161031, "o", "delete: s3://photos/vacation/poolside.jpg\r\n"]
[157.75069, "o", "\r\n\u001b[38;2;142;155;105m▸ List remaining objects (should be 1: info.json)\u001b[0m\r\n"]
[160.25278, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9876 s3 ls s3://photos/ --recursive\u001b[0m\r\n"]
[160.650068, "o", "2026-02-15 12:27:52         35 info.json\r\n"]
