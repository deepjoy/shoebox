[18.396054, "o", "\u001b[1m\u001b[38;2;216;198;176m  CORS on Root Path\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[19.899385, "o", "\r\n\u001b[38;2;142;155;105m▸ Verify CORS on root path (ListBuckets)\u001b[0m\r\n"]
[21.402263, "o", "  \u001b[38;2;197;185;155m# ListBuckets (GET /) has no bucket in the path.\u001b[0m\r\n  \u001b[38;2;197;185;155m# CORS middleware checks all loaded buckets for a matching rule.\u001b[0m\r\n\r\n  \u001b[38;2;197;185;155m# OPTIONS preflight on root path — should return 200 with CORS headers\u001b[0m\r\n\u001b[38;2;183;167;123m$ curl -s -D - -o /dev/null -X OPTIONS 'http://127.0.0.1:9891/' -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: GET' 2>&1 | head -10\u001b[0m\r\n"]
[21.43089, "o", "HTTP/1.1 403 Forbidden\r\r\nallow: GET,HEAD\r\r\ncontent-length: 0\r\r\ndate: Sat, 07 Mar 2026 18:14:30 GMT\r\r\n\r\r\n  \u001b[38;2;197;185;155m(20ms)\u001b[0m\r\n"]
[22.934147, "o", "\r\n  \u001b[38;2;197;185;155m# GET / with Origin header — response should include CORS headers\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/' -H 'Origin: https://example.com' -D - -o /dev/null 2>&1 | head -10\u001b[0m\r\n"]
[22.963336, "o", "HTTP/1.1 200 OK\r\r\ncontent-type: application/xml\r\r\ncontent-length: 308\r\r\ndate: Sat, 07 Mar 2026 18:14:32 GMT\r\r\n\r\r\n  \u001b[38;2;197;185;155m(22ms)\u001b[0m\r\n"]
[24.466439, "o", "\r\n  \u001b[38;2;197;185;155m# Unauthorized origin on root — should return 403\u001b[0m\r\n\u001b[38;2;183;167;123m$ curl -s -o /dev/null -w 'HTTP Status: %{http_code}\r\n' -X OPTIONS 'http://127.0.0.1:9891/' -H 'Origin: https://evil.com' -H 'Access-Control-Request-Method: GET'\u001b[0m\r\n"]
[24.492602, "o", "HTTP Status: 403\r\n  \u001b[38;2;197;185;155m(18ms)\u001b[0m\r\n"]
