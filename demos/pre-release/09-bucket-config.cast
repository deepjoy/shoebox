[18.399432, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  CORS on Requests\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[19.902412, "o", "\r\n\u001b[38;2;142;155;105m▸ Verify CORS headers on regular (authenticated) request\u001b[0m\r\n"]
[21.405949, "o", "  \u001b[38;2;197;185;155m# Upload a test file\u001b[0m\r\n"]
[21.406408, "o", "\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9891 s3 cp '/tmp/tmp.nPNNP2hG4k/cors-test.txt' s3://photos/cors-test.txt\u001b[0m\r\n"]
[23.271735, "o", "Completed 10 Bytes/10 Bytes (489 Bytes/s) with 1 file(s) remaining\rupload: ../../tmp/tmp.nPNNP2hG4k/cors-test.txt to s3://photos/cors-test.txt\r\n  \u001b[38;2;197;185;155m(1858ms)\u001b[0m\r\n"]
[24.774866, "o", "\r\n  \u001b[38;2;197;185;155m# GET with Origin header — response should include CORS headers\u001b[0m\r\n"]
[24.775047, "o", "\u001b[38;2;183;167;123m$ signed_curl GET '/photos/cors-test.txt' -H 'Origin: https://example.com' -D - -o /dev/null 2>&1 | head -15\u001b[0m\r\n"]
[24.805737, "o", "HTTP/1.1 200 OK\r\r\ncontent-type: text/plain\r\r\ncontent-length: 10\r\r\netag: \"82df2417a6e5b63a2c8f34dd9b365ae6\"\r\r\nlast-modified: Sat, 07 Mar 2026 17:55:24 GMT\r\r\nx-amz-checksum-sha256: pRvj328/p2BeYHUd8tuVh6gvRY66HnxRHQfXIVeUgn4=\r\r\nx-amz-checksum-sha1: 3Rq1+4t/TJhNhlPsLB7PZLl0zDs=\r\r\nx-amz-checksum-crc32: L9wRGA==\r\r\nx-amz-checksum-crc32c: uejI7g==\r\r\naccess-control-allow-origin: https://example.com\r\r\nvary: Origin\r\r\naccess-control-expose-headers: ETag, x-amz-meta-custom\r\r\ndate: Sat, 07 Mar 2026 17:55:25 GMT\r\r\n\r\r\n  \u001b[38;2;197;185;155m(23ms)\u001b[0m\r\n"]
[26.308574, "o", "\r\n  \u001b[38;2;197;185;155m# GET with wildcard subdomain Origin header\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/photos/cors-test.txt' -H 'Origin: https://cdn.example.com' -D - -o /dev/null 2>&1 | head -15\u001b[0m\r\n"]
[26.338805, "o", "HTTP/1.1 200 OK\r\r\ncontent-type: text/plain\r\r\ncontent-length: 10\r\r\netag: \"82df2417a6e5b63a2c8f34dd9b365ae6\"\r\r\nlast-modified: Sat, 07 Mar 2026 17:55:24 GMT\r\r\nx-amz-checksum-sha256: pRvj328/p2BeYHUd8tuVh6gvRY66HnxRHQfXIVeUgn4=\r\r\nx-amz-checksum-sha1: 3Rq1+4t/TJhNhlPsLB7PZLl0zDs=\r\r\nx-amz-checksum-crc32: L9wRGA==\r\r\nx-amz-checksum-crc32c: uejI7g==\r\r\naccess-control-allow-origin: https://cdn.example.com\r\r\nvary: Origin\r\r\naccess-control-expose-headers: ETag, x-amz-meta-custom\r\r\ndate: Sat, 07 Mar 2026 17:55:27 GMT\r\r\n\r\r\n  \u001b[38;2;197;185;155m(23ms)\u001b[0m\r\n"]
