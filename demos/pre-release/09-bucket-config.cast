[55.931906, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Delete CORS\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[57.434958, "o", "\r\n\u001b[38;2;142;155;105m▸ Delete CORS configuration\u001b[0m\r\n"]
[58.938143, "o", "\u001b[38;2;183;167;123m$ signed_curl DELETE '/photos?cors' -o /dev/null -w 'HTTP Status: %{http_code}\r\n'\u001b[0m\r\n"]
[58.967399, "o", "HTTP Status: 204\r\n  \u001b[38;2;197;185;155m(21ms)\u001b[0m\r\n"]
[60.470256, "o", "\r\n  \u001b[38;2;197;185;155m# Verify CORS rules are empty\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/photos?cors'\u001b[0m\r\n"]
[60.49829, "o", "[]\r\n  \u001b[38;2;197;185;155m(21ms)\u001b[0m\r\n"]
[62.001436, "o", "\r\n  \u001b[38;2;197;185;155m# Preflight should now return 403 (no CORS rules configured)\u001b[0m\r\n"]
[62.001973, "o", "\u001b[38;2;183;167;123m$ curl -s -o /dev/null -w 'HTTP Status: %{http_code}\r\n' -X OPTIONS 'http://127.0.0.1:9891/photos/test.jpg' -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: GET'\u001b[0m\r\n"]
[62.029531, "o", "HTTP Status: 403\r\n  \u001b[38;2;197;185;155m(20ms)\u001b[0m\r\n"]
[63.53252, "o", "\r\n"]
[65.038157, "o", "\u001b[H\u001b[2J\u001b[3J"]
[65.038514, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Done!\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[66.541383, "o", "\r\n  \u001b[38;2;142;155;105m✓ CORS configuration: PUT, GET, DELETE all working.\u001b[0m\r\n  \u001b[38;2;142;155;105m✓ CORS preflight: exact and subdomain wildcard matching verified.\u001b[0m\r\n  \u001b[38;2;142;155;105m✓ CORS on root path: ListBuckets preflight and response headers verified.\u001b[0m\r\n  \u001b[38;2;142;155;105m✓ Notification configuration: PUT and GET working.\u001b[0m\r\n"]
[66.541496, "o", "  \u001b[38;2;142;155;105m✓ Events emitted on object create and delete.\u001b[0m\r\n\r\n"]
