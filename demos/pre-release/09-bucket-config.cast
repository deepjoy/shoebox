[51.57863, "o", "\r\n  \u001b[38;2;197;185;155m# Delete a file — triggers s3:ObjectRemoved:Delete event\u001b[0m\r\n\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9891 s3 rm s3://photos/uploads/photo.jpg\u001b[0m\r\n"]
