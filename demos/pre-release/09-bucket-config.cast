[3.177075, "o", "\r\n\u001b[38;2;142;155;105m▸ Configure CORS rules for the bucket\u001b[0m\r\n"]
[4.67993, "o", "  \u001b[38;2;197;185;155m# PUT bucket CORS configuration\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl PUT '/photos?cors' -H 'Content-Type: application/json' -d '[{\"allowed_origins\":[\"https://example.com\",\"https://*.example.com\"],\"allowed_methods\":[\"GET\",\"PUT\",\"POST\",\"DELETE\"],\"allowed_headers\":[\"*\"],\"expose_headers\":[\"ETag\",\"x-amz-meta-custom\"],\"max_age_seconds\":3600}]'\u001b[0m\r\n"]
[4.716733, "o", "\r\n  \u001b[38;2;197;185;155m(20ms)\u001b[0m\r\n"]
[6.219857, "o", "\r\n  \u001b[38;2;197;185;155m# GET bucket CORS configuration\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/photos?cors' | python3 -m json.tool\u001b[0m\r\n"]
[6.290175, "o", "[\r\n    {\r\n        \"allowed_origins\": [\r\n            \"https://example.com\",\r\n            \"https://*.example.com\"\r\n        ],\r\n        \"allowed_methods\": [\r\n            \"GET\",\r\n            \"PUT\",\r\n            \"POST\",\r\n            \"DELETE\"\r\n        ],\r\n        \"allowed_headers\": [\r\n            \"*\"\r\n        ],\r\n        \"expose_headers\": [\r\n            \"ETag\",\r\n            \"x-amz-meta-custom\"\r\n        ],\r\n        \"max_age_seconds\": 3600\r\n    }\r\n]\r\n  \u001b[38;2;197;185;155m(63ms)\u001b[0m\r\n"]
