[29.347656, "o", "\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Notification Configuration\u001b[0m\r\n"]
[29.348013, "o", "\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[30.850818, "o", "\r\n\u001b[38;2;142;155;105m▸ Configure webhook notifications\u001b[0m\r\n"]
[32.353987, "o", "  \u001b[38;2;197;185;155m# PUT bucket notification configuration\u001b[0m\r\n"]
[32.354113, "o", "\u001b[38;2;183;167;123m$ signed_curl PUT '/photos?notification' -H 'Content-Type: application/json' -d '[{\"id\":\"image-processor\",\"url\":\"http://localhost:19999/process\",\"events\":[\"s3:ObjectCreated:*\"],\"filter\":{\"prefix\":\"uploads/\",\"suffix\":\".jpg\"}},{\"id\":\"cleanup-notifier\",\"url\":\"http://localhost:19999/cleanup\",\"events\":[\"s3:ObjectRemoved:*\"],\"filter\":null}]'\u001b[0m\r\n"]
[32.384987, "o", "\r\n  \u001b[38;2;197;185;155m(23ms)\u001b[0m\r\n"]
[33.88768, "o", "\r\n  \u001b[38;2;197;185;155m# GET bucket notification configuration\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/photos?notification' | python3 -m json.tool\u001b[0m\r\n"]
[33.952785, "o", "[\r\n    {\r\n        \"id\": \"image-processor\",\r\n        \"url\": \"http://localhost:19999/process\",\r\n        \"events\": [\r\n            \"s3:ObjectCreated:*\"\r\n        ],\r\n        \"filter\": {\r\n            \"prefix\": \"uploads/\",\r\n            \"suffix\": \".jpg\"\r\n        }\r\n    },\r\n    {\r\n        \"id\": \"cleanup-notifier\",\r\n        \"url\": \"http://localhost:19999/cleanup\",\r\n        \"events\": [\r\n            \"s3:ObjectRemoved:*\"\r\n        ],\r\n        \"filter\": null\r\n    }\r\n]\r\n  \u001b[38;2;197;185;155m(57ms)\u001b[0m\r\n"]
[35.455626, "o", "\r\n"]
[36.960747, "o", "\u001b[H\u001b[2J\u001b[3J"]
[36.96108, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Event Emission\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[38.463546, "o", "\r\n\u001b[38;2;142;155;105m▸ Upload & delete objects (events emitted to EventBus)\u001b[0m\r\n"]
[39.966854, "o", "  \u001b[38;2;197;185;155m# Upload a file — triggers s3:ObjectCreated:Put event\u001b[0m\r\n\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9891 s3 cp '/tmp/tmp.nPNNP2hG4k/test.txt' s3://photos/uploads/photo.jpg\u001b[0m\r\n"]
[41.349543, "o", "Completed 20 Bytes/20 Bytes (700 Bytes/s) with 1 file(s) remaining\rupload: ../../tmp/tmp.nPNNP2hG4k/test.txt to s3://photos/uploads/photo.jpg\r\n  \u001b[38;2;197;185;155m(1375ms)\u001b[0m\r\n"]
[42.852182, "o", "\r\n  \u001b[38;2;197;185;155m# Delete a file — triggers s3:ObjectRemoved:Delete event\u001b[0m\r\n\u001b[38;2;183;167;123m$ aws --endpoint-url http://127.0.0.1:9891 s3 rm s3://photos/uploads/photo.jpg\u001b[0m\r\n"]
[44.209356, "o", "delete: s3://photos/uploads/photo.jpg\r\n  \u001b[38;2;197;185;155m(1349ms)\u001b[0m\r\n"]
[45.71179, "o", "\r\n  \u001b[38;2;197;185;155m# Events are delivered to configured webhooks (best-effort with retry).\u001b[0m\r\n  \u001b[38;2;197;185;155m# Since no webhook server is running, delivery will be attempted and logged.\u001b[0m\r\n\r\n"]
[47.217828, "o", "\u001b[H\u001b[2J\u001b[3J"]
[47.218222, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Delete CORS\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[48.721557, "o", "\r\n\u001b[38;2;142;155;105m▸ Delete CORS configuration\u001b[0m\r\n"]
[50.224886, "o", "\u001b[38;2;183;167;123m$ signed_curl DELETE '/photos?cors' -o /dev/null -w 'HTTP Status: %{http_code}\r\n'\u001b[0m\r\n"]
[50.253355, "o", "HTTP Status: 204\r\n  \u001b[38;2;197;185;155m(21ms)\u001b[0m\r\n"]
[51.756196, "o", "\r\n  \u001b[38;2;197;185;155m# Verify CORS rules are empty\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/photos?cors'\u001b[0m\r\n"]
[51.785211, "o", "[]\r\n  \u001b[38;2;197;185;155m(21ms)\u001b[0m\r\n"]
[53.28819, "o", "\r\n  \u001b[38;2;197;185;155m# Preflight should now return 403 (no CORS rules configured)\u001b[0m\r\n\u001b[38;2;183;167;123m$ curl -s -o /dev/null -w 'HTTP Status: %{http_code}\r\n' -X OPTIONS 'http://127.0.0.1:9891/photos/test.jpg' -H 'Origin: https://example.com' -H 'Access-Control-Request-Method: GET'\u001b[0m\r\n"]
[53.315731, "o", "HTTP Status: 403\r\n  \u001b[38;2;197;185;155m(20ms)\u001b[0m\r\n"]
[54.818551, "o", "\r\n"]
