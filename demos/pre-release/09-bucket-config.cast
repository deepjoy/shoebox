[1.671132, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  CORS Configuration\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[3.174242, "o", "\r\n\u001b[38;2;142;155;105m▸ Configure CORS rules for the bucket\u001b[0m\r\n"]
[4.677382, "o", "  \u001b[38;2;197;185;155m# PUT bucket CORS configuration\u001b[0m\r\n"]
[4.677532, "o", "\u001b[38;2;183;167;123m$ signed_curl PUT '/photos?cors' -H 'Content-Type: application/json' -d '[{\"allowed_origins\":[\"https://example.com\",\"https://*.example.com\"],\"allowed_methods\":[\"GET\",\"PUT\",\"POST\",\"DELETE\"],\"allowed_headers\":[\"*\"],\"expose_headers\":[\"ETag\",\"x-amz-meta-custom\"],\"max_age_seconds\":3600}]'\u001b[0m\r\n"]
[4.705622, "o", "\r\n  \u001b[38;2;197;185;155m(20ms)\u001b[0m\r\n"]
[6.208272, "o", "\r\n  \u001b[38;2;197;185;155m# GET bucket CORS configuration\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl GET '/photos?cors' | python3 -m json.tool\u001b[0m\r\n"]
[6.275394, "o", "[\r\n    {\r\n        \"allowed_origins\": [\r\n            \"https://example.com\",\r\n            \"https://*.example.com\"\r\n        ],\r\n        \"allowed_methods\": [\r\n            \"GET\",\r\n            \"PUT\",\r\n            \"POST\",\r\n            \"DELETE\"\r\n        ],\r\n        \"allowed_headers\": [\r\n            \"*\"\r\n        ],\r\n        \"expose_headers\": [\r\n            \"ETag\",\r\n            \"x-amz-meta-custom\"\r\n        ],\r\n        \"max_age_seconds\": 3600\r\n    }\r\n]\r\n  \u001b[38;2;197;185;155m(59ms)\u001b[0m\r\n"]
[7.777866, "o", "\r\n"]
