[127.552365, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Phase 4 Demo Complete\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[129.053962, "o", "  \u001b[38;2;197;185;155m# All Phase 4 features demonstrated successfully:\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - CopyObject within same bucket\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - CopyObject across buckets\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - CopyObject conditional headers (if-match)\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - RenameObject atomic rename\u001b[0m\r\n"]
[129.054318, "o", "  \u001b[38;2;197;185;155m#   - Range: bytes=0-N (first N bytes)\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - Range: bytes=-N (last N bytes)\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - Range: bytes=N- (offset to end)\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - Range returns 206 Partial Content\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - Invalid range returns 416\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - If-Match success and failure\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - If-None-Match returns 304\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - If-Modified-Since works\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - If-Unmodified-Since works\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - Put/Get/Delete object tags\u001b[0m\r\n  \u001b[38;2;197;185;155m#   - Tag limits enforced (10 tags max)\u001b[0m\r\n"]
[129.054406, "o", "  \u001b[38;2;197;185;155m#   - AWS CLI tagging commands work\u001b[0m\r\n"]
