[91.774321, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Object Tagging — Put / Get / Delete\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[93.27578, "o", "\r\n\u001b[38;2;142;155;105m▸ Set tags on fox.txt via AWS CLI\u001b[0m\r\n"]
[94.777696, "o", "\u001b[38;2;183;167;123m$ aws s3api put-object-tagging --bucket photos --key animals/fox.txt --tagging 'TagSet=[{Key=environment,Value=production},{Key=category,Value=animals}]'\u001b[0m\r\n"]
