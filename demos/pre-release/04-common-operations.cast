[113.93029, "o", "\u001b[38;2;183;167;123m$ aws s3api put-object-tagging --bucket photos --key animals/fox.txt --tagging 'TagSet=[{Key=tag1,Value=val1},{Key=tag2,Value=val2},{Key=tag3,Value=val3},{Key=tag4,Value=val4},{Key=tag5,Value=val5},{Key=tag6,Value=val6},{Key=tag7,Value=val7},{Key=tag8,Value=val8},{Key=tag9,Value=val9},{Key=tag10,Value=val10}]'\u001b[0m\r\n"]
