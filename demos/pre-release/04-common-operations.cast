[108.910389, "o", "\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[110.411539, "o", "\r\n\u001b[38;2;142;155;105m▸ Try setting 11 tags (limit is 10, should fail)\u001b[0m\r\n"]
