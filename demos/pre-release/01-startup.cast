{"version": 2, "width": 90, "height": 30, "timestamp": 1771107465, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.014606, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Shoebox — lightweight S3-compatible storage\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[2.516609, "o", "  \u001b[38;2;197;185;155m# Point shoebox at any directory to serve it as an S3 bucket.\u001b[0m\r\n  \u001b[38;2;197;185;155m# Credentials are generated automatically on first run.\u001b[0m\r\n"]
[5.018483, "o", "\r\n\u001b[38;2;142;155;105m▸ Serving a single directory (first run)\u001b[0m\r\n"]
[7.520146, "o", "  \u001b[38;2;197;185;155m# On first run, credentials are generated and displayed automatically.\u001b[0m\r\n\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox '/tmp/tmp.XM2e69TLpL/Photos'\u001b[0m\r\n"]
[7.522904, "o", "Serving 1 bucket on http://0.0.0.0:9000\r\n\r\n  photos → /tmp/tmp.XM2e69TLpL/Photos\r\n    (new) Credentials generated:\r\n      [1] AKIAW4LSTNXIRPKBQYRU (Full access (admin))\r\n          Secret: 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\r\n\r\nCredentials saved to .shoebox/config.toml\r\nUse --show-secrets to display secret access keys\r\n"]
[10.024572, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Subsequent runs\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[12.526018, "o", "  \u001b[38;2;197;185;155m# On subsequent runs, secrets are hidden by default.\u001b[0m\r\n  \u001b[38;2;197;185;155m# Pass --show-secrets to reveal them again.\u001b[0m\r\n"]
[15.027819, "o", "\r\n\u001b[38;2;142;155;105m▸ Re-running the same directory\u001b[0m\r\n"]
[17.529713, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox '/tmp/tmp.XM2e69TLpL/Photos'\u001b[0m\r\n"]
[17.53267, "o", "Serving 1 bucket on http://0.0.0.0:9000\r\n\r\n  photos → /tmp/tmp.XM2e69TLpL/Photos\r\n    Credentials:\r\n      [1] AKIAW4LSTNXIRPKBQYRU (Full access (admin))\r\n\r\nCredentials saved to .shoebox/config.toml\r\nUse --show-secrets to display secret access keys\r\n"]
[20.034793, "o", "\r\n\u001b[38;2;142;155;105m▸ With --show-secrets\u001b[0m\r\n"]
[22.536863, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox --show-secrets '/tmp/tmp.XM2e69TLpL/Photos'\u001b[0m\r\n"]
[22.539636, "o", "Serving 1 bucket on http://0.0.0.0:9000\r\n\r\n  photos → /tmp/tmp.XM2e69TLpL/Photos\r\n    Credentials:\r\n      [1] AKIAW4LSTNXIRPKBQYRU (Full access (admin))\r\n          Secret: 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\r\n\r\nCredentials saved to .shoebox/config.toml\r\n"]
[25.041334, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Multiple directories at once\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[27.542959, "o", "  \u001b[38;2;197;185;155m# Pass several paths to serve them all from one instance.\u001b[0m\r\n"]
[30.045121, "o", "\r\n\u001b[38;2;142;155;105m▸ Serving three directories\u001b[0m\r\n"]
[32.546731, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox '/tmp/tmp.XM2e69TLpL/Photos' '/tmp/tmp.XM2e69TLpL/Videos' '/tmp/tmp.XM2e69TLpL/Documents'\u001b[0m\r\n"]
[32.54963, "o", "Serving 3 buckets on http://0.0.0.0:9000\r\n\r\n  photos → /tmp/tmp.XM2e69TLpL/Photos\r\n    Credentials:\r\n      [1] AKIAW4LSTNXIRPKBQYRU (Full access (admin))\r\n\r\n  videos → /tmp/tmp.XM2e69TLpL/Videos\r\n    (new) Credentials generated:\r\n      [1] AKIAWQ3P4XTCW3N6HPSQ (Full access (admin))\r\n          Secret: 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\r\n\r\n  documents → /tmp/tmp.XM2e69TLpL/Documents\r\n    (new) Credentials generated:\r\n      [1] AKIANDJHSMI4VWGD6PLG (Full access (admin))\r\n          Secret: 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\r\n\r\n"]
[32.549749, "o", "Credentials saved to .shoebox/config.toml\r\nUse --show-secrets to display secret access keys\r\n"]
[35.05147, "o", "\r\n\u001b[38;2;142;155;105m▸ Custom host and port\u001b[0m\r\n"]
[37.55294, "o", "  \u001b[38;2;197;185;155m# Use --host and --port (or env vars) to change the listen address.\u001b[0m\r\n"]
[40.055099, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox --host 127.0.0.1 --port 8080 '/tmp/tmp.XM2e69TLpL/Photos'\u001b[0m\r\n"]
[40.057775, "o", "Serving 1 bucket on http://127.0.0.1:8080\r\n\r\n  photos → /tmp/tmp.XM2e69TLpL/Photos\r\n    Credentials:\r\n      [1] AKIAW4LSTNXIRPKBQYRU (Full access (admin))\r\n\r\nCredentials saved to .shoebox/config.toml\r\nUse --show-secrets to display secret access keys\r\n"]
[42.560407, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Done!\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[45.0624, "o", "  \u001b[38;2;197;185;155m# Each directory now has a .shoebox/config.toml with its credentials.\u001b[0m\r\n\r\n\u001b[38;2;142;155;105m▸ Peeking at generated config\u001b[0m\r\n"]
[47.564555, "o", "\u001b[38;2;183;167;123m$ cat '/tmp/tmp.XM2e69TLpL/Photos/.shoebox/config.toml'\u001b[0m\r\n"]
[47.566006, "o", "versioning_enabled = false\r\n\r\n[[credentials]]\r\naccess_key_id = \"AKIAW4LSTNXIRPKBQYRU\"\r\nsecret_access_key = \"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\"\r\ndescription = \"Full access (admin)\"\r\n"]
[50.067434, "o", "\r\n  \u001b[38;2;142;155;105m✓ That's shoebox — zero-config, no-copy, S3-compatible local storage.\u001b[0m\r\n\r\n"]
