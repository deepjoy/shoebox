[0.014668, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Shoebox — lightweight S3-compatible storage\u001b[0m\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[1.515811, "o", "  \u001b[38;2;197;185;155m# Point shoebox at any directory to serve it as an S3 bucket.\u001b[0m\r\n  \u001b[38;2;197;185;155m# Credentials are generated automatically on first run.\u001b[0m\r\n\r\n\u001b[38;2;142;155;105m▸ Serving a single directory (first run)\u001b[0m\r\n"]
[3.017574, "o", "  \u001b[38;2;197;185;155m# On first run, credentials are generated and displayed automatically.\u001b[0m\r\n"]
[3.017634, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox --host 127.0.0.1 --port 9870 '/tmp/tmp.C9Q9WOVJFz/Photos'\u001b[0m\r\n"]
[3.337491, "o", "  photos -> /tmp/tmp.C9Q9WOVJFz/Photos\r\n    (new) Credentials generated:\r\n      [1] AKIAEUOGYHLPMLTQKGYI (Full access (admin))\r\n          Secret: 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\r\n\r\n    To enable browser access (CORS), run:\r\n\r\n      export AWS_ACCESS_KEY_ID='AKIAEUOGYHLPMLTQKGYI'\r\n      export AWS_SECRET_ACCESS_KEY='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'\r\n      export BUCKET='photos'\r\n\r\n      curl -X PUT \"http://127.0.0.1:9870/${BUCKET}?cors\" \\\r\n        --aws-sigv4 \"aws:amz:us-east-1:s3\" \\\r\n        --user \"$AWS_ACCESS_KEY_ID:$AWS_SECRET_ACCESS_KEY\" \\\r\n        -H \"Content-Type: application/json\" \\\r\n        -d '[{\"allowed_origins\":[\"*\"],\"allowed_methods\":[\"GET\",\"PUT\",\"POST\",\"DELETE\",\"HEAD\"],\"allowed_headers\":[\"*\"],\"expose_headers\":[\"ETag\",\"x-amz-request-id\"],\"max_age_seconds\":3600}]'\r\n\r\nServing 1 bucket on http://127.0.0.1:9870\r\nCredentials saved to .shoebox/config.toml\r\nUse --show-secrets to display secret access keys\r\n\r\n"]
[6.36335, "o", "\u001b[H\u001b[2J\u001b[3J"]
