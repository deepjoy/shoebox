[7.865035, "o", "  \u001b[38;2;197;185;155m# On subsequent runs, secrets are hidden by default.\u001b[0m\r\n  \u001b[38;2;197;185;155m# Pass --show-secrets to reveal them again.\u001b[0m\r\n\r\n\u001b[38;2;142;155;105m▸ Re-running the same directory\u001b[0m\r\n"]
[9.367155, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox --host 127.0.0.1 --port 9871 '/tmp/tmp.C9Q9WOVJFz/Photos'\u001b[0m\r\n"]
