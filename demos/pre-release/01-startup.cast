{"version": 2, "width": 90, "height": 30, "timestamp": 1771105392, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.01479, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Shoebox — lightweight S3-compatible storage\u001b[0m\r\n"]
[0.015476, "o", "\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[2.516015, "o", "  \u001b[38;2;197;185;155m# Point shoebox at any directory to serve it as an S3 bucket.\u001b[0m\r\n  \u001b[38;2;197;185;155m# Credentials are generated automatically on first run.\u001b[0m\r\n"]
[5.017626, "o", "\r\n\u001b[38;2;142;155;105m▸ Serving a single directory\u001b[0m\r\n"]
[7.519541, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox '/tmp/tmp.ENQGPJx1fi/Photos'\u001b[0m\r\n"]
[7.522644, "o", "Serving 1 bucket on http://0.0.0.0:9000\r\n\r\n  photos → /tmp/tmp.ENQGPJx1fi/Photos\r\n    Credentials:\r\n      [1] AKIABUPHUCJGJKDGIBKU (Full access (admin))\r\n          Secret: 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\r\n\r\nCredentials saved to .shoebox/config.toml\r\n"]
[10.0244, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Multiple directories at once\u001b[0m\r\n"]
[10.024468, "o", "\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[12.526158, "o", "  \u001b[38;2;197;185;155m# Pass several paths to serve them all from one instance.\u001b[0m\r\n"]
[15.027673, "o", "\r\n\u001b[38;2;142;155;105m▸ Serving three directories\u001b[0m\r\n"]
[17.529114, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox '/tmp/tmp.ENQGPJx1fi/Photos' '/tmp/tmp.ENQGPJx1fi/Videos' '/tmp/tmp.ENQGPJx1fi/Documents'\u001b[0m\r\n"]
[17.531642, "o", "Serving 3 buckets on http://0.0.0.0:9000\r\n\r\n  photos → /tmp/tmp.ENQGPJx1fi/Photos\r\n    Credentials:\r\n      [1] AKIABUPHUCJGJKDGIBKU (Full access (admin))\r\n          Secret: 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\r\n\r\n  videos → /tmp/tmp.ENQGPJx1fi/Videos\r\n    Credentials:\r\n      [1] AKIAX63KCJKY6SAXTU67 (Full access (admin))\r\n          Secret: 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\r\n\r\n"]
[17.531698, "o", "  documents → /tmp/tmp.ENQGPJx1fi/Documents\r\n    Credentials:\r\n      [1] AKIATIJGFWLHCHAMAVMH (Full access (admin))\r\n          Secret: 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\r\n\r\nCredentials saved to .shoebox/config.toml\r\n"]
[20.03378, "o", "\r\n\u001b[38;2;142;155;105m▸ Custom host and port\u001b[0m\r\n"]
[22.535574, "o", "  \u001b[38;2;197;185;155m# Use --host and --port (or env vars) to change the listen address.\u001b[0m\r\n"]
[25.037569, "o", "\u001b[38;2;183;167;123m$ SHOEBOX_LOG=off /workspaces/shoebox/target/release/shoebox --host 127.0.0.1 --port 8080 '/tmp/tmp.ENQGPJx1fi/Photos'\u001b[0m\r\n"]
[25.040268, "o", "Serving 1 bucket on http://127.0.0.1:8080\r\n\r\n  photos → /tmp/tmp.ENQGPJx1fi/Photos\r\n    Credentials:\r\n      [1] AKIABUPHUCJGJKDGIBKU (Full access (admin))\r\n          Secret: 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\r\n\r\nCredentials saved to .shoebox/config.toml\r\n"]
[27.541999, "o", "\r\n\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[38;2;216;198;176m  Done!\u001b[0m\r\n"]
[27.542143, "o", "\u001b[38;2;73;110;93m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[30.04358, "o", "  \u001b[38;2;197;185;155m# Each directory now has a .shoebox/config.toml with its credentials.\u001b[0m\r\n\r\n\u001b[38;2;142;155;105m▸ Peeking at generated config\u001b[0m\r\n"]
[32.545738, "o", "\u001b[38;2;183;167;123m$ cat '/tmp/tmp.ENQGPJx1fi/Photos/.shoebox/config.toml'\u001b[0m\r\n"]
[32.546861, "o", "versioning_enabled = false\r\n\r\n[[credentials]]\r\naccess_key_id = \"AKIABUPHUCJGJKDGIBKU\"\r\nsecret_access_key = \"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\"\r\ndescription = \"Full access (admin)\"\r\n"]
[35.048181, "o", "\r\n  \u001b[38;2;142;155;105m✓ That's shoebox — zero-config, no-copy, S3-compatible local storage.\u001b[0m\r\n\r\n"]
