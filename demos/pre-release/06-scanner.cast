[73.743483, "o", "  \u001b[38;2;197;185;155m#   [x] Background scans don't block API\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Filesystem watcher detects new files\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Filesystem watcher detects modifications\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Filesystem watcher detects deletions\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] S3 API operations coexist with scanner-managed objects\u001b[0m\r\n  \u001b[38;2;197;185;155m# \u001b[0m\r\n  \u001b[38;2;197;185;155m# Items tested via unit/integration tests (not in demo):\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] L3 detects file modification during scan\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] P0 scan preempts P1/P2\u001b[0m\r\n  \u001b[38;2;197;185;155m#   [x] Debouncing prevents duplicate events\u001b[0m\r\n"]
