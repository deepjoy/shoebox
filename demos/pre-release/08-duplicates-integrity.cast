[24.195372, "o", "\r\n\u001b[38;2;142;155;105m▸ MergeDuplicates — pick a winner, delete the losers\u001b[0m\r\n"]
[25.69777, "o", "  \u001b[38;2;197;185;155m# POST /{bucket}?merge with JSON body specifying winner_key and loser_keys.\u001b[0m\r\n  \u001b[38;2;197;185;155m# This keeps originals/sunset.txt and deletes the backup and edited copies.\u001b[0m\r\n\u001b[38;2;183;167;123m$ signed_curl POST '/photos?merge'     -H 'Content-Type: application/json'     -d '{\"winner_key\": \"originals/sunset.txt\", \"loser_keys\": [\"backup/sunset.txt\", \"edited/sunset-copy.txt\"]}'\u001b[0m\r\n"]
[25.71476, "o", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><MergeResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><WinnerObjectId>1cc4adbe-6f12-44a5-941f-17fc2d2e59ea</WinnerObjectId><LosersMerged>2</LosersMerged></MergeResult>\r\n  \u001b[38;2;197;185;155m(12ms)\u001b[0m\r\n"]
